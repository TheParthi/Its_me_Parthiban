{
  "name": "parthiban-portfolio-platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @pg/api",
    "dev:admin": "npm run dev -w @pg/admin",
    "dev:web": "npm run dev -w @pg/web",
    "build": "npm run build -w @pg/shared && npm run build -w @pg/api && npm run build -w @pg/admin && npm run build -w @pg/web",
    "test": "npm run test -w @pg/api",
    "db:migrate": "npm run prisma:migrate -w @pg/api",
    "db:seed": "npm run seed -w @pg/api",
    "admin:create": "npm run admin:create -w @pg/api",
    "deploy:web": "npm run deploy -w @pg/web"
  }
}
