# Origin of the portfolio CMS API (no trailing slash, no /api suffix).
# Optional: when unset — or when the API is unreachable — the site renders
# from the static files in src/data exactly as before, with no analytics and
# the mailto contact form.
#
#   Development:  VITE_API_URL=http://localhost:4000
#   Production:   VITE_API_URL=https://api.example.com
#
# The API must list this site's origin in PUBLIC_SITE_ORIGINS for CORS.
VITE_API_URL=
