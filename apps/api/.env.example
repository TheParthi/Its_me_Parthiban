# ---------------------------------------------------------------------------
# Portfolio API configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USER@localhost:5432/portfolio_dev?schema=public"

# Secrets — generate each with:  openssl rand -base64 48   (ENCRYPTION_KEY: openssl rand -base64 32)
JWT_ACCESS_SECRET=
ENCRYPTION_KEY=
IP_HASH_SALT=

# Origins
ADMIN_ORIGIN=http://localhost:5174          # where the admin dashboard runs (same origin as the API in production)
PUBLIC_SITE_URL=http://localhost:5173/       # the public portfolio
PUBLIC_SITE_ORIGINS=http://localhost:5173    # comma-separated origins allowed to call /api/public
COOKIE_SECURE=false                          # true in production (HTTPS)
TRUST_PROXY=false                            # true behind a load balancer / reverse proxy

# Media storage: "local" (disk, for development) or "s3" (AWS S3 or compatible)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                               # only for S3-compatible services
# S3_FORCE_PATH_STYLE=false
# MEDIA_PUBLIC_BASE_URL=https://<bucket>.s3.<region>.amazonaws.com   (or your CloudFront URL)

# Email (optional). Without SMTP, reset/invite links are printed to the dev console only.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Portfolio Admin <no-reply@example.com>"
# NOTIFY_EMAIL=

# Production: path to the built admin SPA served at /admin
# ADMIN_DIST_DIR=../admin/dist
